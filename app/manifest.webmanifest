    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#FFFFFF",
  "theme_color": "#FFFFFF",
  "categories": [
    "shopping",
    "lifestyle"
  ],
  "prefer_related_applications": false,
  "icons": [
